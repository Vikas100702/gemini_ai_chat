# ============================================================================
# MONOREPO ROOT .gitignore (Flutter Frontend + Node.js/TypeScript Backend)
# ============================================================================

# --- Secrets & Environment Variables (CRITICAL: Protects GEMINI_API_KEY) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Node.js / TypeScript Backend Artifacts ---
node_modules/
dist/
coverage/
.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Miscellaneous ---
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# --- IntelliJ / Android Studio / VS Code ---
*.iml
*.ipr
*.iws
.idea/
.vscode/

# --- Flutter / Dart / Pub Related ---
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
frontend/build/

# --- Symbolication & Obfuscation ---
app.*.symbols
app.*.map.json

# --- Android Studio Build Artifacts ---
/android/app/debug
/android/app/profile
/android/app/release
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties

# --- FVM Version Cache ---
.fvm/